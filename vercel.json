{
  "buildCommand": "npm run build",
  "installCommand": "echo \"No dependencies to install\"",
  "outputDirectory": "site",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "destination": "/console/?demo",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
